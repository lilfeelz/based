#!/bin/sh
set -eu
cd "$(dirname "$0")"
engine="${BASED_CONTAINER:-container}"
if [ "$engine" = container ] && [ "$(launchctl managername 2>/dev/null)" != "Aqua" ]; then
  printf 'container needs the GUI session. Run from Terminal.app, or:\n' >&2
  printf '  sudo launchctl asuser %s sudo -u %s %s/%s\n' \
    "$(id -u)" "$USER" "$PWD" "$(basename "$0")" >&2
  exit 1
fi
if [ "$engine" = container ]; then
  container system start >/dev/null 2>&1 || true
fi
name=zmx-based
image="${BASED_IMAGE:-ghcr.io/lilfeelz/based:latest}"

case "${1:-}" in
  stop)
    "$engine" rm -f "$name" 2>/dev/null || true
    exit 0
    ;;
  build)
    exec "$engine" build --tag "$image" --file .devcontainer/Dockerfile .
    ;;
  "") ;;
  *)
    printf 'usage: run [build | stop]\n' >&2
    exit 2
    ;;
esac

if ! "$engine" inspect "$name" >/dev/null 2>&1; then
  if ! "$engine" image inspect "$image" >/dev/null 2>&1; then
    "$engine" build --tag "$image" --file .devcontainer/Dockerfile .
  fi
  "$engine" run -d --name "$name" --user vscode \
    --volume "$PWD:/workspaces/based" --workdir /workspaces/based \
    "$image" sleep infinity
else
  "$engine" start "$name" >/dev/null 2>&1 || true
fi

exec "$engine" exec -it --user vscode \
  --workdir /workspaces/based "$name" zsh -l
