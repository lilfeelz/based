#!/bin/sh
set -eu

if [ "${1:-}" = "--" ]; then
  shift
  IFS= read -r host || exit 0
  [ -n "$host" ] || exit 0
  exec ssh -t -- "$host" "$@"
fi

case "${1:-}" in
  "")
    {
      if [ -f "${SSH_CONFIG:-$HOME/.ssh/config}" ]; then
        awk 'tolower($1) == "host" {
          for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i
        }' "${SSH_CONFIG:-$HOME/.ssh/config}"
      fi
      if command -v tailscale >/dev/null 2>&1; then
        tailscale status --self=false 2>/dev/null | awk '{print $2}' || true
      fi
    } | awk '!seen[$0]++'
    ;;
  -*)
    printf 'usage: d [HOST [-- CMD...]] (or pipe HOST to d -- [CMD...])\n' >&2
    exit 2
    ;;
  *)
    host="$1"
    shift
    if [ "${1:-}" = "--" ]; then shift; fi
    exec ssh -t -- "$host" "$@"
    ;;
esac
