#!/bin/sh
set -eu
export ZMX_NO_DETACH_KEY=1

resolve_target() {
  t="$1"
  case "$t" in
    \~) t="$HOME" ;;
    \~/*) t="$HOME/${t#*/}" ;;
  esac
  if [ -d "$t" ]; then
    dir=$(CDPATH='' cd -- "$t" && pwd -P)
    name=$(basename "$dir")
    if [ "$dir" = "$HOME" ]; then name=home; fi
  else
    dir=$(pwd -P)
    name="$t"
  fi
}

cmd="${1:-list}"
case "$cmd" in
  list)
    zmx list --short 2>/dev/null || true
    ;;
  detach)
    zmx detach
    ;;
  delete)
    shift
    if [ "$#" -gt 0 ]; then
      printf '%s\n' "$@"
    else
      cat
    fi | while IFS= read -r target; do
      [ -n "$target" ] || continue
      resolve_target "$target"
      zmx kill "$name"
    done
    ;;
  *)
    if [ "$cmd" = attach ]; then
      shift || true
      if [ "$#" -gt 0 ]; then
        target="$1"
      elif [ ! -t 0 ]; then
        IFS= read -r target || exit 0
      else
        target=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
      fi
    else
      target="$cmd"
    fi
    [ -n "$target" ] || exit 0
    resolve_target "$target"
    cd "$dir"
    SHELL="${SHELL:-$(command -v zsh || command -v sh)}"
    export SHELL
    # zmx 0.8.1 switches by name only; create the target before asking the current client to switch.
    if [ -n "${ZMX_SESSION:-}" ]; then
      ZMX_SESSION='' zmx attach "$name" dvtm -m '^G' </dev/null >/dev/null
    elif [ ! -t 0 ]; then
      exec </dev/tty
    fi
    exec zmx attach "$name" dvtm -m '^G'
    ;;
esac
