#!/bin/sh
set -eu
export ZMX_NO_DETACH_KEY=1

if [ -n "${BASED_MUX:-}" ]; then
  mux="$BASED_MUX"
elif [ "$(uname -s)" = Darwin ]; then
  mux=rex
else
  mux=zmx
fi

resolve_target() {
  t="$1"
  case "$t" in
    \~) t="$HOME" ;;
    \~/*) t="$HOME/${t#*/}" ;;
  esac
  if [ -d "$t" ]; then
    dir=$(CDPATH='' cd -- "$t" && pwd -P)
    name=$(basename "$dir")
    if [ "$dir" = "$HOME" ]; then name=home; fi
  else
    dir=$(pwd -P)
    name="$t"
  fi
}

cmd="${1:-attach}"
case "$cmd" in
  list)
    case "$mux" in
      rex) rex ls 2>/dev/null | awk 'NR>1 {print $2}' || true ;;
      *) zmx list --short 2>/dev/null || true ;;
    esac
    ;;
  detach)
    case "$mux" in
      rex) rex detach ;;
      *) zmx detach ;;
    esac
    ;;
  delete)
    shift
    if [ "$#" -gt 0 ]; then
      printf '%s\n' "$@"
    else
      cat
    fi | while IFS= read -r target; do
      [ -n "$target" ] || continue
      resolve_target "$target"
      case "$mux" in
        rex) rex kill "$name" ;;
        *) zmx kill "$name" ;;
      esac
    done
    ;;
  *)
    if [ "$cmd" = attach ]; then
      shift || true
      if [ "$#" -gt 0 ]; then
        target="$1"
      elif [ ! -t 0 ]; then
        IFS= read -r target || exit 0
      else
        target=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
      fi
    else
      target="$cmd"
    fi
    [ -n "$target" ] || exit 0
    resolve_target "$target"
    case "$mux" in
      rex)
        if ! rex ls 2>/dev/null | awk 'NR>1 {print $2}' | grep -qxF "$name"; then
          rex new "$name" -c "$dir" --window zsh -- /bin/zsh -l >/dev/null
        fi
        exec rex attach "$name"
        ;;
      *)
        cd "$dir"
        SHELL="${SHELL:-$(command -v zsh || command -v sh)}"
        export SHELL
        exec zmx attach "$name" dvtm -m '^a'
        ;;
    esac
    ;;
esac
