#!/bin/sh
set -eu
export ZMX_NO_DETACH_KEY=1

backend() {
  if [ -n "${BASED_MUX:-}" ]; then
    printf '%s\n' "$BASED_MUX"
  elif [ "$(uname -s)" = Darwin ]; then
    printf 'rex\n'
  else
    printf 'zmx\n'
  fi
}

resolve_target() {
  t="$1"
  case "$t" in
    \~) t="$HOME" ;;
    \~/*) t="$HOME/${t#*/}" ;;
  esac
  if [ -d "$t" ]; then
    dir=$(CDPATH='' cd -- "$t" && pwd -P)
    name=$(basename "$dir")
    if [ "$dir" = "$HOME" ]; then name=home; fi
  else
    dir=$(pwd -P)
    name="$t"
  fi
}

attach_one() {
  [ -n "$1" ] || return 0
  resolve_target "$1"
  case "$(backend)" in
    rex)
      if ! rex ls 2>/dev/null | awk 'NR>1 {print $2}' | grep -qxF "$name"; then
        rex new "$name" -c "$dir" --window zsh -- /bin/zsh -l >/dev/null
      fi
      exec rex attach "$name"
      ;;
    *)
      cd "$dir"
      SHELL="${SHELL:-$(command -v zsh || command -v sh)}"
      export SHELL
      exec zmx attach "$name" dvtm -m '^a'
      ;;
  esac
}

delete_one() {
  [ -n "$1" ] || return 0
  resolve_target "$1"
  case "$(backend)" in
    rex) rex kill "$name" ;;
    *) zmx kill "$name" ;;
  esac
}

cmd="${1:-attach}"
case "$cmd" in
  list)
    case "$(backend)" in
      rex) rex ls 2>/dev/null | awk 'NR>1 {print $2}' || true ;;
      *) zmx list --short 2>/dev/null || true ;;
    esac
    ;;
  detach)
    case "$(backend)" in
      rex) rex detach ;;
      *) zmx detach ;;
    esac
    ;;
  delete)
    shift
    if [ "$#" -gt 0 ]; then
      for target in "$@"; do delete_one "$target"; done
    else
      while IFS= read -r target; do delete_one "$target"; done
    fi
    ;;
  attach)
    shift || true
    if [ "$#" -gt 0 ]; then
      attach_one "$1"
    elif [ ! -t 0 ]; then
      IFS= read -r target || exit 0
      attach_one "$target"
    else
      root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
      attach_one "$root"
    fi
    ;;
  *)
    attach_one "$cmd"
    ;;
esac
