#!/bin/sh
set -eu

BASED_CONFIG="${BASED_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/based}"
KEYBINDS="${BASED_KEYBINDS:-$BASED_CONFIG/keybinds.tsv}"

cmd="${1:-list}"
case "$cmd" in
  list)
    [ -f "$KEYBINDS" ] || exit 0
    if [ -n "${2:-}" ]; then
      awk -F '\t' -v t="$2" '$1 == t' "$KEYBINDS"
    else
      grep -v '^[[:space:]]*#' "$KEYBINDS" | grep -v '^[[:space:]]*$' || true
    fi
    ;;
  edit)
    case "${2:-}" in
      zsh) target="$BASED_CONFIG/zshrc" ;;
      nvim) target="${BASED_NVIM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/nvim}/init.lua" ;;
      rift) target="$BASED_CONFIG/rift.toml" ;;
      *) target="$KEYBINDS" ;;
    esac
    exec "${EDITOR:-nvim}" "$target"
    ;;
  delete)
    shift
    if [ "$#" -lt 2 ] && [ -t 0 ]; then
      printf 'usage: k delete TOOL KEY (or pipe from k list)\n' >&2
      exit 2
    fi
    if [ "$#" -ge 2 ]; then
      printf '%s\t%s\n' "$1" "$2"
    else
      cat
    fi | while IFS="$(printf '\t')" read -r tool key _rest; do
      if [ -f "$KEYBINDS" ] && [ -n "${tool:-}" ] && [ -n "${key:-}" ]; then
        tmp=$(mktemp)
        awk -F '\t' -v t="$tool" -v k="$key" '!(($1 == t) && ($2 == k))' "$KEYBINDS" >"$tmp"
        mv "$tmp" "$KEYBINDS"
      fi
    done
    ;;
  *)
    printf 'usage: k [list [TOOL] | edit [TOOL] | delete [TOOL KEY]]\n' >&2
    exit 2
    ;;
esac
