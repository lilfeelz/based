#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}
eq() { [ "$1" = "$2" ] || fail "expected '$2', got '$1'"; }
has() { printf '%s\n' "$1" | grep -qxF "$2" || fail "missing '$2' in '$1'"; }

sh "$root/.githooks/pre-commit"

orig_path="$PATH"
export HOME="$t/home"
export PATH="$t/mock:$root/bin:$PATH"
export BASED_CONFIG="$HOME/.config/based"
export BASED_NVIM_CONFIG="$HOME/.config/nvim"
mkdir -p "$HOME" "$t/mock"

mock() {
  {
    printf '#!/bin/sh\n'
    cat
  } >"$t/mock/$1"
  chmod 0755 "$t/mock/$1"
}

tilde='~'

# a, e, f, g, h, s: single-letter wrappers
for cmd in pi nvim fd git man rg; do
  mock "$cmd" <<EOF
printf "$cmd:%s\n" "\$*"
EOF
done
eq "$(a fix)" "pi:fix"
eq "$(e file.txt)" "nvim:file.txt"
eq "$(f pat)" "fd:--hidden --follow --exclude .git pat"
eq "$(g status)" "git:status"
eq "$(h ls)" "man:ls"
eq "$(s needle)" "rg:--hidden --smart-case --glob !.git needle"
[ -n "$(l "$HOME")" ] || fail "l produced empty output"

# w: lists workspace directories
mkdir -p "$HOME/Notes/topic" "$HOME/Workspaces/ctx/proj"
out=$(cd "$HOME" && w)
has "$out" "$tilde"
has "$out" "$tilde/Notes"
has "$out" "$tilde/Notes/topic"
has "$out" "$tilde/Workspaces/ctx/proj"

# m & j: list, attach via stdin/arg, detach, delete via stdin
# macOS uses the same session backend as Linux and Termux.
mock uname <<'EOF'
printf 'Darwin\n'
EOF
export ZMX_SESSION=test-session
mock zmx <<'EOF'
printf "zmx:%s\n" "$*"
EOF
mkdir -p "$HOME/Workspaces/ctx/demo"
eq "$(m </dev/null)" "zmx:list --short"
eq "$(m demo)" "zmx:attach demo dvtm -m ^G"
eq "$(m list)" "zmx:list --short"
eq "$(printf '' | m attach)" ""
eq "$(printf '%s\n' "$tilde/Workspaces/ctx/demo" | m attach)" "zmx:attach demo dvtm -m ^G"
eq "$(j demo)" "zmx:attach demo dvtm -m ^G"
eq "$(m detach)" "zmx:detach"
eq "$(printf 'one\ntwo\n' | m delete)" "$(printf 'zmx:kill one\nzmx:kill two')"

# New sessions are created outside the current session before switching.
mock zmx <<'EOF'
if [ -z "${ZMX_SESSION:-}" ]; then
  printf '%s|%s\n' "$PWD" "$*" >"$HOME/created-session"
else
  [ -f "$HOME/created-session" ] || exit 1
  printf "zmx:%s\n" "$*"
fi
EOF
eq "$(m "$HOME/Workspaces/ctx/demo")" "zmx:attach demo dvtm -m ^G"
demo_dir=$(CDPATH='' cd -- "$HOME/Workspaces/ctx/demo" && pwd -P)
eq "$(cat "$HOME/created-session")" "$demo_dir|attach demo dvtm -m ^G"
python3 "$root/test/mux.py" "$root"

# d: lists ssh hosts and connects
export SSH_CONFIG="$t/ssh_config"
printf 'Host *\n  User j\nHost book pixel\n  HostName 10.0.0.1\n' >"$SSH_CONFIG"
mock tailscale <<'EOF'
exit 1
EOF
mock ssh <<'EOF'
printf "ssh:%s\n" "$*"
EOF
eq "$(d </dev/null)" "$(printf 'book\npixel')"
eq "$(d list)" "ssh:-t -- list"
eq "$(printf 'pixel\n' | d --)" "ssh:-t -- pixel"
eq "$(printf 'pixel\n' | d -- j)" "ssh:-t -- pixel j"
eq "$(d book -- m)" "ssh:-t -- book m"
eq "$(d book)" "ssh:-t -- book"
eq "$(printf '' | d --)" ""
if d -bad >/dev/null 2>&1; then fail "d accepted an option as host"; fi

# k: list, delete via stdin, edit
mkdir -p "$BASED_CONFIG"
printf 'nvim\t<Space>ff\tfiles\nzsh\tf\tfd\nzsh\ts\trg\n' >"$BASED_CONFIG/keybinds.tsv"
eq "$(k list zsh | wc -l | tr -d ' ')" "2"
printf 'zsh\tf\tfd\n' | k delete
eq "$(k list)" "$(printf 'nvim\t<Space>ff\tfiles\nzsh\ts\trg')"
eq "$(EDITOR="echo" k edit zsh)" "$BASED_CONFIG/zshrc"

# install/common.sh config
cfg_home="$t/cfg-home"
env -i HOME="$cfg_home" PATH="$orig_path" sh "$root/install/common.sh" config >/dev/null
for b in "$root"/bin/*; do
  [ -x "$cfg_home/.local/bin/${b##*/}" ] || fail "missing primitive ${b##*/}"
done
[ -f "$cfg_home/.config/nvim/init.lua" ] || fail "missing init.lua"
for c in "$root"/config/*; do
  [ "${c##*/}" = init.lua ] && continue
  [ -f "$cfg_home/.config/based/${c##*/}" ] || fail "missing config ${c##*/}"
done

# make: building must never start or attach a container, including under CI's Docker.
mock docker <<'EOF'
printf "docker:%s\n" "$*"
EOF
eq "$(make -s --no-print-directory -C "$root" build ENGINE=docker IMAGE=based-test:local)" \
  "docker:build --tag based-test:local --file .devcontainer/Dockerfile ."
eq "$(make -s --no-print-directory -C "$root" stop ENGINE=docker)" "docker:rm -f zmx-based"
if BASED_CONTAINER=docker "$root/run" unknown >/dev/null 2>&1; then
  fail "run accepted an unknown operation"
fi

# Install dispatch is checked with a fake shell, never against the real home or package manager.
mock sh <<'EOF'
printf "sh:%s\n" "$*"
EOF
mock uname <<'EOF'
printf 'Darwin\n'
EOF
eq "$(TERMUX_VERSION='' make -s --no-print-directory -C "$root" install)" "sh:install/macos.sh"
eq "$(TERMUX_VERSION='test' make -s --no-print-directory -C "$root" install)" "sh:install/termux.sh"
mock uname <<'EOF'
printf 'Linux\n'
EOF
if TERMUX_VERSION='' make -s --no-print-directory -C "$root" install >/dev/null 2>&1; then
  fail "native Linux install must not run the image's root installer"
fi

# The macOS entry point installs the same session tools as other platforms.
mock brew <<'EOF'
exit 0
EOF
eq "$(/bin/sh "$root/install/macos.sh")" "sh:$root/install/common.sh zmx dvtm nvim pi config"

# optional full pinned install check (--install)
if [ "${1:-}" = "--install" ]; then
  ih="$t/install-home"
  set -- zmx dvtm nvim pi
  env -i HOME="$ih" PATH="$orig_path" sh "$root/install/common.sh" "$@" config
  for term in dvtm dvtm-256color; do
    env -i HOME="$ih" PATH="$orig_path" infocmp "$term" >/dev/null || fail "missing terminfo $term"
  done
  for b in "$@"; do
    [ -x "$ih/.local/bin/$b" ] || fail "missing binary $b"
  done
  for b in "$root"/bin/*; do
    [ -x "$ih/.local/bin/${b##*/}" ] || fail "missing primitive ${b##*/}"
  done
  [ -f "$ih/.config/nvim/init.lua" ] || fail "missing init.lua"
  for c in "$root"/config/*; do
    [ "${c##*/}" = init.lua ] && continue
    [ -f "$ih/.config/based/${c##*/}" ] || fail "missing config ${c##*/}"
  done
fi

printf 'ok\n'
