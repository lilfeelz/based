#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}
eq() { [ "$1" = "$2" ] || fail "expected '$2', got '$1'"; }
has() { printf '%s\n' "$1" | grep -qxF "$2" || fail "missing '$2' in '$1'"; }

sh "$root/.githooks/pre-commit"

orig_path="$PATH"
export HOME="$t/home"
export PATH="$t/mock:$root/bin:$PATH"
export BASED_CONFIG="$HOME/.config/based"
export BASED_NVIM_CONFIG="$HOME/.config/nvim"
mkdir -p "$HOME" "$t/mock"

mock() {
  {
    printf '#!/bin/sh\n'
    cat
  } >"$t/mock/$1"
  chmod 0755 "$t/mock/$1"
}

tilde='~'

# a, e, f, g, h, s: single-letter wrappers
for cmd in pi nvim fd git man rg; do
  mock "$cmd" <<EOF
printf "$cmd:%s\n" "\$*"
EOF
done
eq "$(a fix)" "pi:fix"
eq "$(e file.txt)" "nvim:file.txt"
eq "$(f pat)" "fd:--hidden --follow --exclude .git pat"
eq "$(g status)" "git:status"
eq "$(h ls)" "man:ls"
eq "$(s needle)" "rg:--hidden --smart-case --glob !.git needle"
[ -n "$(l "$HOME")" ] || fail "l produced empty output"

# w: lists workspace directories
mkdir -p "$HOME/Notes/topic" "$HOME/Workspaces/ctx/proj"
out=$(cd "$HOME" && w)
has "$out" "$tilde"
has "$out" "$tilde/Notes"
has "$out" "$tilde/Notes/topic"
has "$out" "$tilde/Workspaces/ctx/proj"

# m (zmx) & j: list, attach via stdin/arg, detach, delete via stdin
export BASED_MUX=zmx
mock zmx <<'EOF'
printf "zmx:%s\n" "$*"
EOF
mkdir -p "$HOME/Workspaces/ctx/demo"
eq "$(m list)" "zmx:list --short"
eq "$(printf '%s\n' "$tilde/Workspaces/ctx/demo" | m attach)" "zmx:attach demo dvtm -m ^a"
eq "$(j demo)" "zmx:attach demo dvtm -m ^a"
eq "$(m detach)" "zmx:detach"
eq "$(printf 'one\ntwo\n' | m delete)" "$(printf 'zmx:kill one\nzmx:kill two')"

# m (rex): list, attach, delete
export BASED_MUX=rex
mock rex <<'EOF'
if [ "$1" = ls ]; then printf "ID NAME\n1 alpha\n"; else printf "rex:%s\n" "$*"; fi
EOF
eq "$(m list)" "alpha"
eq "$(m attach alpha)" "rex:attach alpha"
eq "$(m delete alpha)" "rex:kill alpha"

# d: lists ssh hosts and connects
export SSH_CONFIG="$t/ssh_config"
printf 'Host *\n  User j\nHost book pixel\n  HostName 10.0.0.1\n' >"$SSH_CONFIG"
mock tailscale <<'EOF'
exit 1
EOF
mock ssh <<'EOF'
printf "ssh:%s\n" "$*"
EOF
eq "$(d list)" "$(printf 'book\npixel')"
eq "$(printf 'pixel\n' | d)" "ssh:-t -- pixel"
eq "$(d book m list)" "ssh:-t -- book m list"

# k: list, delete via stdin, edit
mkdir -p "$BASED_CONFIG"
printf 'nvim\t<Space>ff\tfiles\nzsh\tf\tfd\nzsh\ts\trg\n' >"$BASED_CONFIG/keybinds.tsv"
eq "$(k list zsh | wc -l | tr -d ' ')" "2"
printf 'zsh\tf\tfd\n' | k delete
eq "$(k list)" "$(printf 'nvim\t<Space>ff\tfiles\nzsh\ts\trg')"
eq "$(EDITOR="echo" k edit zsh)" "$BASED_CONFIG/zshrc"

# install/common.sh config
cfg_home="$t/cfg-home"
env -i HOME="$cfg_home" PATH="$orig_path" sh "$root/install/common.sh" config >/dev/null
for b in "$root"/bin/*; do
  [ -x "$cfg_home/.local/bin/${b##*/}" ] || fail "missing primitive ${b##*/}"
done
[ -f "$cfg_home/.config/nvim/init.lua" ] || fail "missing init.lua"
for c in "$root"/config/*; do
  [ "${c##*/}" = init.lua ] && continue
  [ -f "$cfg_home/.config/based/${c##*/}" ] || fail "missing config ${c##*/}"
done

# optional full pinned install check (--install)
if [ "${1:-}" = "--install" ]; then
  ih="$t/install-home"
  env -i HOME="$ih" PATH="$orig_path" sh "$root/install/common.sh" zmx dvtm nvim pi config
  for b in zmx dvtm nvim pi; do
    [ -x "$ih/.local/bin/$b" ] || fail "missing binary $b"
  done
  for b in "$root"/bin/*; do
    [ -x "$ih/.local/bin/${b##*/}" ] || fail "missing primitive ${b##*/}"
  done
  [ -f "$ih/.config/nvim/init.lua" ] || fail "missing init.lua"
  for c in "$root"/config/*; do
    [ "${c##*/}" = init.lua ] && continue
    [ -f "$ih/.config/based/${c##*/}" ] || fail "missing config ${c##*/}"
  done
fi

printf 'ok\n'
